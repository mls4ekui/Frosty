<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Frosty">

    <SolidColorBrush x:Key="WinBgBrush" Color="#0F1726" />
    <SolidColorBrush x:Key="WinHeadBrush" Color="#152033" />
    <SolidColorBrush x:Key="CardBgBrush" Color="#131D2E" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#223047" />
    <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CardDescStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <Style x:Key="SliderLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style x:Key="SliderValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Строгий квадратный тумблер -->
    <Style x:Key="FluentToggleStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="46" Height="24" Background="Transparent">
                        <Border x:Name="FocusBorder"
                                CornerRadius="0"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed"
                                Margin="-2" />
                        <Border Width="44"
                                Height="22"
                                CornerRadius="0"
                                Background="#172236"
                                BorderBrush="#223047"
                                BorderThickness="1"
                                ui:Motion.HoverBackground="#1C2A42"
                                ui:Motion.HoverBorder="#38BDF8"
                                ui:Motion.CheckedBackground="#38BDF8"
                                ui:Motion.CheckedBorder="#38BDF8" />
                        <Rectangle Width="14"
                                   Height="14"
                                   Fill="#94A3B8"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="5,0,0,0"
                                   ui:Motion.CheckedBackground="#041624"
                                   ui:Motion.HoverScale="1.08"
                                   ui:Motion.PressedScale="0.92"
                                   ui:Motion.CheckedOffsetX="22" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вторичная квадратная кнопка (.b на сайте) -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#F3F4F6" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="#172236"
                            BorderBrush="#223047"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}"
                            ui:Motion.HoverBackground="#1A324C"
                            ui:Motion.PressedBackground="#132338"
                            ui:Motion.HoverBorder="#38BDF8"
                            ui:Motion.PressedBorder="#38BDF8"
                            ui:Motion.FocusBorder="#38BDF8"
                            ui:Motion.PressedScale="0.98">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Главная акцентная кнопка (.b.p на сайте) -->
    <Style x:Key="PrimaryBtnStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#041624" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="#38BDF8"
                            BorderBrush="#38BDF8"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}"
                            ui:Motion.HoverBackground="#7DD3FC"
                            ui:Motion.PressedBackground="#0284C7"
                            ui:Motion.HoverBorder="#7DD3FC"
                            ui:Motion.PressedBorder="#0284C7"
                            ui:Motion.FocusBorder="#FFFFFF"
                            ui:Motion.PressedScale="0.98">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Квадратная кнопка закрытия в шапке окна (.wclose на сайте) -->
    <Style x:Key="CloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="35" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent"
                            CornerRadius="0"
                            ui:Motion.HoverBackground="#E11D48"
                            ui:Motion.PressedBackground="#BE123C">
                        <Path x:Name="CrossPath"
                              Data="M7,7 L17,17 M7,17 L17,7"
                              Stroke="#94A3B8"
                              StrokeThickness="1.6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CrossPath" Property="Stroke" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Карточка выбора пресета -->
    <Style x:Key="PresetCardRadioStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="#131D2E"
                            BorderBrush="#223047"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="13,10"
                            ui:Motion.HoverBackground="#17243A"
                            ui:Motion.HoverBorder="#38BDF8"
                            ui:Motion.CheckedBackground="#162C46"
                            ui:Motion.CheckedBorder="#38BDF8"
                            ui:Motion.FocusBorder="#38BDF8"
                            ui:Motion.PressedScale="0.99">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка выбора палитры снега -->
    <Style x:Key="ColorSwatchStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Foreground" Value="#F3F4F6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Padding="13,8"
                            CornerRadius="0"
                            Background="#172236"
                            BorderBrush="#223047"
                            BorderThickness="1"
                            ui:Motion.HoverBackground="#1A2B44"
                            ui:Motion.HoverBorder="#38BDF8"
                            ui:Motion.CheckedBackground="#162C46"
                            ui:Motion.CheckedBorder="#38BDF8"
                            ui:Motion.FocusBorder="#FFFFFF"
                            ui:Motion.PressedScale="0.98">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вкладка бокового меню -->
    <Style x:Key="NavTabStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="12,10"
                            ui:Motion.HoverBackground="#131D2E"
                            ui:Motion.CheckedBackground="#152033"
                            ui:Motion.CheckedBorder="#223047"
                            ui:Motion.FocusBorder="#38BDF8">
                        <Grid>
                            <Border Width="3"
                                    Height="20"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="0"
                                    Background="#0038BDF8"
                                    Margin="-12,0,0,0"
                                    ui:Motion.CheckedBackground="#38BDF8" />
                            <ContentPresenter VerticalAlignment="Center" Margin="4,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Строгий квадратный слайдер -->
    <Style x:Key="SliderFillRepeatStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" Height="22">
                        <Border Height="4" CornerRadius="0" Background="#38BDF8" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderEmptyRepeatStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" Height="22" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="14" Height="14" Background="Transparent">
                        <Rectangle Width="24"
                                   Height="24"
                                   Fill="#0038BDF8"
                                   IsHitTestVisible="False"
                                   ui:Motion.HoverBackground="#2438BDF8"
                                   ui:Motion.PressedBackground="#4038BDF8" />
                        <Rectangle Width="14"
                                   Height="14"
                                   Fill="#F3F4F6"
                                   Stroke="#38BDF8"
                                   StrokeThickness="2"
                                   ui:Motion.HoverScale="1.12"
                                   ui:Motion.PressedScale="1.02" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="22" Background="Transparent">
                        <Border Height="4" CornerRadius="0" Background="#223047" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFillRepeatStyle}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEmptyRepeatStyle}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>