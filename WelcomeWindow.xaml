<Window x:Class="Frosty.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Frosty"
        Title="Мастер настройки Frosty"
        Width="1000"
        Height="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        Topmost="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="-1"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            CornerRadius="0"
            Background="#0F1726"
            BorderBrush="#223047"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2" />
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- Верхний ледяной кант 2px -->
            <Border Grid.Row="0" Background="#38BDF8" />

            <!-- Строгая шапка окна -->
            <Border Grid.Row="1"
                    Background="#152033"
                    CornerRadius="0"
                    BorderBrush="#223047"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <Grid Margin="14,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:AppLogoImage Width="17" Height="17" Margin="0,0,8,0" />
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="Первоначальная настройка Frosty"
                                   Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="RU" Foreground="#94A3B8" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                        <CheckBox x:Name="WelcomeLangToggle"
                                  Style="{StaticResource FluentToggleStyle}"
                                  Margin="8,0,8,0"
                                  Click="OnWelcomeLanguageClicked" />
                        <TextBlock Text="EN" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Style="{StaticResource CloseButtonStyle}" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основная рабочая область мастера -->
            <Grid Grid.Row="2" Margin="24,18,22,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="370" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="StepsHost" Grid.Column="0">
                    <ScrollViewer x:Name="Step1Panel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                        <StackPanel>
                            <TextBlock x:Name="S1Title" Text="Добро пожаловать в Frosty" Foreground="#F3F4F6" FontSize="21" FontWeight="Bold" />
                            <TextBlock x:Name="S1Sub" Text="Живой снегопад прямо на рабочем столе. За минуту познакомимся и настроим всё под вас." Style="{StaticResource CardDescStyle}" FontSize="12.5" Margin="0,4,0,16" />
                            <Border Style="{StaticResource CardStyle}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="🌨️" FontSize="20" FontFamily="Segoe UI Emoji" Foreground="#38BDF8" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="S1C1Title" Text="Снег идёт поверх всех окон" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="S1C1Desc" Text="Хлопья падают на рабочий стол, ложатся на заголовки окон и панель задач и образуют настоящие сугробы." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="🖱️" FontSize="20" FontFamily="Segoe UI Emoji" Foreground="#38BDF8" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="S1C2Title" Text="Не мешает работе" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="S1C2Desc" Text="Окна, ярлыки и программы работают как обычно. В полноэкранных играх снегопад сам уходит на паузу." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="🔔" FontSize="20" FontFamily="Segoe UI Emoji" Foreground="#38BDF8" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="S1C3Title" Text="Живёт в системном трее" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="S1C3Desc" Text="Иконка возле часов открывает настройки. Ctrl+Alt+S – пауза, Ctrl+Alt+C – очистить весь снег." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="👀" FontSize="20" FontFamily="Segoe UI Emoji" Foreground="#38BDF8" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="S1C4Title" Text="Всё видно в окне справа" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="S1C4Desc" Text="Пока открыт мастер, снег идёт только в окне предпросмотра. На рабочий стол он выйдет, когда вы нажмёте «Готово»." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="Step2Panel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="S2Title" Text="Как играть со снегом" Foreground="#F3F4F6" FontSize="21" FontWeight="Bold" />
                            <TextBlock x:Name="S2Sub" Text="Снег – не просто картинка. С ним можно взаимодействовать. Попробуйте прямо в окне предпросмотра справа." Style="{StaticResource CardDescStyle}" FontSize="12.5" Margin="0,4,0,16" />
                            <Border Style="{StaticResource CardStyle}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="⛄" FontSize="20" FontFamily="Segoe UI Emoji" Foreground="#38BDF8" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="S2C1Title" Text="Снежки и снеговики" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="S2C1Desc" Text="Зажмите левую кнопку мыши на сугробе и потяните – слепится снежок. Сложите 2–3 кома вместе – получится снеговик." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="💨" FontSize="20" FontFamily="Segoe UI Emoji" Foreground="#38BDF8" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="S2C2Title" Text="Разгоните снег курсором" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="S2C2Desc" Text="Проведите мышью сквозь падающие хлопья – они разлетятся в стороны." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="🖥" FontSize="20" FontFamily="Segoe UI Emoji" Foreground="#38BDF8" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="S2C3Title" Text="Снег стряхивается" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="S2C3Desc" Text="Если резко потрясти окно, снег с него осыплется вниз. Брошенные снежки оставляют следы на экране." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="⚙️" FontSize="20" FontFamily="Segoe UI Emoji" Foreground="#38BDF8" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="S2C4Title" Text="Всё это настраивается" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="S2C4Desc" Text="На следующих шагах вы выберете внешний вид, физику и поведение – и сразу увидите результат." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="Step3Panel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="S3Title" Text="Погода и внешний вид" Foreground="#F3F4F6" FontSize="21" FontWeight="Bold" />
                            <TextBlock x:Name="S3Sub" Text="Выберите пресет и подкрутите детали – предпросмотр обновляется мгновенно." Style="{StaticResource CardDescStyle}" FontSize="12.5" Margin="0,4,0,16" />
                            <TextBlock x:Name="S3PresetHdr" Text="ПРЕСЕТ" Foreground="#94A3B8" FontSize="11.5" FontWeight="SemiBold" Margin="2,6,0,8" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <RadioButton x:Name="PresetCozyRadio" GroupName="Presets" Style="{StaticResource PresetCardRadioStyle}" Grid.Row="0" Grid.Column="0" Margin="0,0,4,8" Checked="OnPresetRadioChecked">
                                    <StackPanel>
                                        <TextBlock x:Name="WPresetCozyTitle" Text="Уютный" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="WPresetCozyDesc" Text="Редкие, неспешные хлопья." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="PresetClassicRadio" GroupName="Presets" Style="{StaticResource PresetCardRadioStyle}" Grid.Row="0" Grid.Column="1" Margin="4,0,0,8" Checked="OnPresetRadioChecked">
                                    <StackPanel>
                                        <TextBlock x:Name="WPresetClassicTitle" Text="Классика" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="WPresetClassicDesc" Text="Сбалансированный вариант." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="PresetHeavyRadio" GroupName="Presets" Style="{StaticResource PresetCardRadioStyle}" Grid.Row="1" Grid.Column="0" Margin="0,0,4,0" Checked="OnPresetRadioChecked">
                                    <StackPanel>
                                        <TextBlock x:Name="WPresetHeavyTitle" Text="Снегопад" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="WPresetHeavyDesc" Text="Плотный, но спокойный снег." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="PresetCyberRadio" GroupName="Presets" Style="{StaticResource PresetCardRadioStyle}" Grid.Row="1" Grid.Column="1" Margin="4,0,0,0" Checked="OnPresetRadioChecked">
                                    <StackPanel>
                                        <TextBlock x:Name="WPresetCyberTitle" Text="Киберпанк" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="WPresetCyberDesc" Text="Неоновые хлопья." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                            <TextBlock x:Name="S3ColorHdr" Text="ЦВЕТ СНЕГА" Foreground="#94A3B8" FontSize="11.5" FontWeight="SemiBold" Margin="2,6,0,8" />
                            <WrapPanel Margin="0,0,0,6">
                                <RadioButton x:Name="WelcomeThemeWhite" GroupName="Themes" Style="{StaticResource ColorSwatchStyle}" Checked="OnWelcomeThemeChecked">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="11" Height="11" Fill="#F8FAFC" Margin="0,0,8,0" />
                                        <TextBlock x:Name="WThemeWhiteTxt" Text="Классический" FontSize="12.5" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="WelcomeThemeNeon" GroupName="Themes" Style="{StaticResource ColorSwatchStyle}" Checked="OnWelcomeThemeChecked">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="11" Height="11" Fill="#22D3EE" Margin="0,0,8,0" />
                                        <TextBlock x:Name="WThemeNeonTxt" Text="Неон" FontSize="12.5" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="WelcomeThemeGold" GroupName="Themes" Style="{StaticResource ColorSwatchStyle}" Checked="OnWelcomeThemeChecked">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="11" Height="11" Fill="#FBBF24" Margin="0,0,8,0" />
                                        <TextBlock x:Name="WThemeGoldTxt" Text="Золото" FontSize="12.5" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="WelcomeThemeConfetti" GroupName="Themes" Style="{StaticResource ColorSwatchStyle}" Checked="OnWelcomeThemeChecked">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="11" Height="11" Fill="#F472B6" Margin="0,0,8,0" />
                                        <TextBlock x:Name="WThemeConfettiTxt" Text="Конфетти" FontSize="12.5" />
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>
                            <TextBlock x:Name="S3ParamsHdr" Text="ПАРАМЕТРЫ" Foreground="#94A3B8" FontSize="11.5" FontWeight="SemiBold" Margin="2,6,0,8" />
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="WDensityLbl" Text="Плотность снегопада" Style="{StaticResource SliderLabelStyle}" />
                                        <TextBlock x:Name="DensityValue" Style="{StaticResource SliderValueStyle}" />
                                    </Grid>
                                    <Slider x:Name="DensitySlider" Minimum="100" Maximum="2500" IsMoveToPointEnabled="True" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="WSizeLbl" Text="Размер снежинок" Style="{StaticResource SliderLabelStyle}" />
                                        <TextBlock x:Name="SizeValue" Style="{StaticResource SliderValueStyle}" />
                                    </Grid>
                                    <Slider x:Name="SizeSlider" Minimum="0.5" Maximum="2.5" IsMoveToPointEnabled="True" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="WSpeedLbl" Text="Скорость падения" Style="{StaticResource SliderLabelStyle}" />
                                        <TextBlock x:Name="SpeedValue" Style="{StaticResource SliderValueStyle}" />
                                    </Grid>
                                    <Slider x:Name="SpeedSlider" Minimum="0.3" Maximum="3.0" IsMoveToPointEnabled="True" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="WWindLbl" Text="Сила ветра" Style="{StaticResource SliderLabelStyle}" />
                                        <TextBlock x:Name="WindValue" Style="{StaticResource SliderValueStyle}" />
                                    </Grid>
                                    <Slider x:Name="WindSlider" Minimum="0.0" Maximum="4.0" IsMoveToPointEnabled="True" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="Step4Panel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="S4Title" Text="Сугробы и физика" Foreground="#F3F4F6" FontSize="21" FontWeight="Bold" />
                            <TextBlock x:Name="S4Sub" Text="Как снег копится и как реагирует на вас. Попробуйте потрогать его в предпросмотре." Style="{StaticResource CardDescStyle}" FontSize="12.5" Margin="0,4,0,16" />
                            <TextBlock x:Name="S4DriftsHdr" Text="СУГРОБЫ" Foreground="#94A3B8" FontSize="11.5" FontWeight="SemiBold" Margin="2,6,0,8" />
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="WHeightLbl" Text="Максимальная высота сугробов" Style="{StaticResource SliderLabelStyle}" />
                                        <TextBlock x:Name="HeightValue" Style="{StaticResource SliderValueStyle}" />
                                    </Grid>
                                    <Slider x:Name="HeightSlider" Minimum="10" Maximum="95" IsMoveToPointEnabled="True" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="WAccumLbl" Text="Скорость накопления" Style="{StaticResource SliderLabelStyle}" />
                                        <TextBlock x:Name="AccumValue" Style="{StaticResource SliderValueStyle}" />
                                    </Grid>
                                    <Slider x:Name="AccumSlider" Minimum="0.2" Maximum="3.0" IsMoveToPointEnabled="True" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="WSwayLbl" Text="Покачивание хлопьев" Style="{StaticResource SliderLabelStyle}" />
                                        <TextBlock x:Name="SwayValue" Style="{StaticResource SliderValueStyle}" />
                                    </Grid>
                                    <Slider x:Name="SwaySlider" Minimum="0.0" Maximum="2.5" IsMoveToPointEnabled="True" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="S4InterHdr" Text="ВЗАИМОДЕЙСТВИЕ" Foreground="#94A3B8" FontSize="11.5" FontWeight="SemiBold" Margin="2,6,0,8" />
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="WCraftTitle" Text="Снежки и пятна на экране" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="WCraftDesc" Text="Лепите снежки из сугробов; брошенные снежки оставляют следы." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="WelcomeCraftingToggle" Grid.Column="1" Style="{StaticResource FluentToggleStyle}" Click="OnWelcomeFeatureToggled" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="WSnowmenTitle" Text="Живые снеговики" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="WSnowmenDesc" Text="Снежки превращаются в снеговиков." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="WelcomeSnowmenToggle" Grid.Column="1" Style="{StaticResource FluentToggleStyle}" Click="OnWelcomeFeatureToggled" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="WScatterTitle" Text="Разлёт снега от курсора" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="WScatterDesc" Text="Курсор раздувает падающие хлопья." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="WelcomeScatterToggle" Grid.Column="1" Style="{StaticResource FluentToggleStyle}" Click="OnWelcomeFeatureToggled" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="WScatterPowLbl" Text="Сила разлёта" Style="{StaticResource SliderLabelStyle}" />
                                        <TextBlock x:Name="ScatterPowerValue" Style="{StaticResource SliderValueStyle}" />
                                    </Grid>
                                    <Slider x:Name="ScatterPowerSlider" Minimum="0.5" Maximum="2.5" IsMoveToPointEnabled="True" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="WGravityLbl" Text="Гравитация предметов" Style="{StaticResource SliderLabelStyle}" />
                                        <TextBlock x:Name="GravityValue" Style="{StaticResource SliderValueStyle}" />
                                    </Grid>
                                    <Slider x:Name="GravitySlider" Minimum="0.5" Maximum="2.0" IsMoveToPointEnabled="True" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="WShakeTitle" Text="Стряхивание снега с окон" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="WShakeDesc" Text="Встряхните окно – снег с него осыплется." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="WelcomeShakeToggle" Grid.Column="1" Style="{StaticResource FluentToggleStyle}" Click="OnWelcomeFeatureToggled" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="Step5Panel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="S5Title" Text="Поведение и система" Foreground="#F3F4F6" FontSize="21" FontWeight="Bold" />
                            <TextBlock x:Name="S5Sub" Text="Последний шаг. Эти параметры действуют на рабочем столе (в предпросмотре виден только снег на панели задач)." Style="{StaticResource CardDescStyle}" FontSize="12.5" Margin="0,4,0,16" />
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="WOcclTitle" Text="Снег ложится на окна" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="WOcclDesc" Text="Хлопья скрываются за окнами и копятся на их верхних краях." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="WelcomeOcclusionToggle" Grid.Column="1" Style="{StaticResource FluentToggleStyle}" Click="OnWelcomeFeatureToggled" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="WTaskbarTitle" Text="Сугробы на панели задач" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="WTaskbarDesc" Text="Снег накапливается на панели задач Windows." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="WelcomeTaskbarToggle" Grid.Column="1" Style="{StaticResource FluentToggleStyle}" Click="OnWelcomeFeatureToggled" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="WGamePauseTitle" Text="Автопауза в полноэкранных играх" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="WGamePauseDesc" Text="Снег скрывается и не расходует ресурсы, пока вы играете или смотрите видео." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="WelcomeGamePauseToggle" Grid.Column="1" Style="{StaticResource FluentToggleStyle}" Click="OnWelcomeFeatureToggled" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="WPowerTitle" Text="Энергосбережение при простое" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="WPowerDesc" Text="Снижает нагрузку, когда вы долго не двигаете мышь." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="WelcomePowerSaveToggle" Grid.Column="1" Style="{StaticResource FluentToggleStyle}" Click="OnWelcomeFeatureToggled" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="WAnimTitle" Text="Анимации интерфейса" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="WAnimDesc" Text="Плавные переходы кнопок, переключателей и окон. Можно отключить в любой момент." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="WelcomeAnimationsToggle" Grid.Column="1" Style="{StaticResource FluentToggleStyle}" Click="OnWelcomeFeatureToggled" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="WAutoStartTitle" Text="Запускать вместе с Windows" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="WAutoStartDesc" Text="Frosty будет стартовать в системном трее. Настройки всегда открываются кликом по иконке." Style="{StaticResource CardDescStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Name="WelcomeAutoStartToggle" Grid.Column="1" Style="{StaticResource FluentToggleStyle}" Click="OnWelcomeAutoStartClicked" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Окно живого предпросмотра справа -->
                <Border Grid.Column="2"
                        CornerRadius="0"
                        BorderBrush="#223047"
                        BorderThickness="1"
                        Background="#131D2E">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <local:SnowPreviewControl x:Name="Preview" Grid.Row="0" Margin="1" />
                        <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                                Background="#D90F1726" BorderBrush="#223047" BorderThickness="1" CornerRadius="0" Padding="8,3" IsHitTestVisible="False">
                            <TextBlock x:Name="PreviewBadgeText" Text="ПРЕДПРОСМОТР" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold" />
                        </Border>
                        <Border Grid.Row="1" Background="#0F1726" BorderBrush="#223047" BorderThickness="0,1,0,0" Padding="12,8,12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PreviewHintText"
                                           Text="Лепите снежки зажатой кнопкой мыши, водите курсором сквозь снег."
                                           Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button x:Name="ClearPreviewBtn" Grid.Column="1" Content="Очистить" Style="{StaticResource ActionButtonStyle}"
                                        Padding="10,6" FontSize="11.5" Margin="10,0,0,0" Click="OnClearPreviewClick" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Нижняя панель навигации в стиле панели задач сайта -->
            <Border Grid.Row="3"
                    Background="#0A101C"
                    CornerRadius="0"
                    BorderBrush="#223047"
                    BorderThickness="0,1,0,0"
                    Padding="24,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <StackPanel x:Name="DotsPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                        <TextBlock x:Name="StepCounterText" Text="Шаг 1 из 5"
                                   Foreground="#94A3B8" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BackBtn" Content="← Назад" Style="{StaticResource ActionButtonStyle}"
                                Padding="18,9" FontSize="13" Click="OnBackClick" Visibility="Collapsed" Margin="0,0,10,0" />
                        <Button x:Name="NextBtn" Content="Далее →" Style="{StaticResource PrimaryBtnStyle}" Click="OnNextClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>